---
import '../styles/global.css';
import { Image } from 'astro:assets';
import marchio from '../assets/ssl-mark.png';
import Contatto from '../components/Contatto.astro';

interface Props { title: string; description: string; senzaContatto?: boolean }
const { title, description, senzaContatto = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const menu = [
  ['Formazione', '/formazione/'],
  ['F-Gas', '/f-gas/'],
  ['Consulenza', '/consulenza/'],
  ['CEAS', '/ceas/'],
  ['Chi siamo', '/chi-siamo/'],
  ['Contatti', '/contatti/'],
];
const attivo = (href: string) => path.startsWith(href);
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Staging: nessuna indicizzazione finché il dominio non è collegato. RIMUOVERE AL LANCIO. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" />
  </head>
  <body>
    <div class="blobs" aria-hidden="true"><i></i><i></i><i></i></div>

    <header class="navbar" id="navbar">
      <nav aria-label="Principale">
        <a class="marchio" href="/" aria-label="Servizi Sicurezza Lavoro – home">
          <Image src={marchio} alt="" width={44} height={44} loading="eager" />
          <span><b>Servizi Sicurezza Lavoro</b><small>Siniscola · Sardegna</small></span>
        </a>
        <div class="menu">
          {menu.map(([etichetta, href]) => <a href={href} aria-current={attivo(href) ? 'page' : undefined}>{etichetta}</a>)}
        </div>
        <button class="hamburger" id="hamburger" aria-label="Menu" aria-expanded="false" aria-controls="tendina">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path id="hamburger-icona" d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </button>
        <a class="btn btn-primario btn-piccolo" href="#contatti" data-contatti>Richiedi preventivo</a>
      </nav>
      <div class="tendina" id="tendina">
        {menu.map(([etichetta, href]) => <a href={href} aria-current={attivo(href) ? 'page' : undefined}>{etichetta}</a>)}
      </div>
    </header>

    <main>
      <slot />
      {!senzaContatto && <Contatto />}
    </main>

    <footer class="sito">
      <div><strong>Servizi Sicurezza Lavoro snc</strong><span>Sede legale: Loc. Salapattu snc – 08029 Siniscola (NU)</span><span>P.IVA 01313770917</span></div>
      <div><strong>Contatti</strong><a href="tel:+3907841949743">+39 0784 1949743</a><a href="mailto:info@servizisicurezzalavoro.it">info@servizisicurezzalavoro.it</a></div>
      <div><strong>CEAS</strong><span>Dorgali – Cala Gonone</span><span>Omodeo – Sedilo</span></div>
      <div class="legali"><a href="/privacy/">Privacy</a><a href="/cookie/">Cookie</a></div>
    </footer>

    <div class="barra-mobile">
      <a class="chiama" href="tel:+3907841949743">Chiama</a>
      <!-- WhatsApp: sostituire con https://wa.me/<numero> quando Davide fornisce il numero -->
      <a class="scrivi" href="#contatti" data-contatti>Scrivici</a>
    </div>

    <script is:inline>
      (function () {
        var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var nav = document.getElementById('navbar');
        var onScroll = function () { nav.classList.toggle('scroll', scrollY > 40); };
        addEventListener('scroll', onScroll, { passive: true }); onScroll();

        var burger = document.getElementById('hamburger'), drop = document.getElementById('tendina'), icona = document.getElementById('hamburger-icona');
        burger.addEventListener('click', function () {
          var aperto = drop.classList.toggle('aperta');
          burger.setAttribute('aria-expanded', aperto);
          icona.setAttribute('d', aperto ? 'M6 6l12 12M18 6 6 18' : 'M4 7h16M4 12h16M4 17h16');
        });

        // Highlight del vetro che segue il cursore
        document.querySelectorAll('.glow').forEach(function (el) {
          el.addEventListener('mousemove', function (e) {
            var r = el.getBoundingClientRect();
            el.style.setProperty('--mx', e.clientX - r.left + 'px'); el.style.setProperty('--my', e.clientY - r.top + 'px');
          });
        });

        // Comparsa allo scroll: solo per elementi fuori schermo; il contenuto resta comunque visibile.
        if (!reduced && 'IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (voci) {
            voci.forEach(function (v) { if (v.isIntersecting) { v.target.classList.add('rivela-in'); io.unobserve(v.target); } });
          }, { threshold: 0.12 });
          document.querySelectorAll('[data-reveal]').forEach(function (el) {
            if (el.getBoundingClientRect().top > innerHeight) io.observe(el);
          });
        }

        // "Richiedi preventivo": scorre al modulo, con offset per la navbar
        document.querySelectorAll('[data-contatti]').forEach(function (a) {
          a.addEventListener('click', function (e) {
            var t = document.getElementById('contatti'); if (!t) return;
            e.preventDefault();
            scrollTo({ top: t.getBoundingClientRect().top + scrollY - 90, behavior: reduced ? 'auto' : 'smooth' });
          });
        });
      })();
    </script>
  </body>
</html>
