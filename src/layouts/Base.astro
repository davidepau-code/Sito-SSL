---
import '../styles/global.css';
import { Image } from 'astro:assets';
import marchio from '../assets/ssl-mark.png';
import Contatto from '../components/Contatto.astro';
import Schema from '../components/Schema.astro';
import { ClientRouter } from 'astro:transitions';
import { azienda } from '../data/azienda';
import CookieBanner from '../components/CookieBanner.astro';

interface Props { title: string; description: string; senzaContatto?: boolean; crumbs?: { nome: string; url: string }[] }
const { title, description, senzaContatto = false, crumbs } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const menu = [
  ['Home', '/'],
  ['Formazione', '/formazione/'],
  ['F-Gas', '/f-gas/'],
  ['Consulenza', '/consulenza/'],
  ['CEAS', '/ceas/'],
  ['Chi siamo', '/chi-siamo/'],
  ['Contatti', '/contatti/'],
];
const attivo = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="it" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Il sito gestisce da sé tema chiaro e scuro: dichiararlo impedisce ai browser di forzare una "modalità scura automatica" che romperebbe lo stile. -->
    <meta name="color-scheme" content="light dark" />
    <script is:inline>try{var t=localStorage.getItem('tema');if(t==='dark'||t==='light')document.documentElement.dataset.tema=t;}catch(e){}</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:image" content={new URL('/ssl-mark.png', Astro.site)} />
    <meta property="og:site_name" content="Servizi Sicurezza Lavoro" />
    <meta name="twitter:card" content="summary" />
    {/* Indicizzazione: attiva solo con PUBLIC_INDEXABLE=true (variabile di build, da impostare al lancio). */}
    {import.meta.env.PUBLIC_INDEXABLE !== 'true' && <meta name="robots" content="noindex, nofollow" />}
    <Schema crumbs={crumbs} />
    <ClientRouter />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="blobs" aria-hidden="true" transition:persist="blobs"><i></i><i></i><i></i></div>

    <header class="navbar" id="navbar" transition:persist="navbar">
      <nav aria-label="Principale">
        <a class="marchio" href="/" aria-label="Servizi Sicurezza Lavoro – home">
          <Image src={marchio} alt="" width={44} height={44} loading="eager" />
          <span><b>Servizi Sicurezza Lavoro</b><small>Siniscola · Sardegna</small></span>
        </a>
        <div class="menu">
          <span class="menu-ind" aria-hidden="true"></span>
          {menu.map(([etichetta, href]) => <a href={href} aria-current={attivo(href) ? 'page' : undefined}>{etichetta}</a>)}
        </div>
        <button class="hamburger" id="hamburger" aria-label="Menu" aria-expanded="false" aria-controls="tendina">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path id="hamburger-icona" d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </button>
        <button class="tema" id="tema" type="button" aria-label="Cambia tema chiaro/scuro" title="Tema chiaro/scuro">
          <svg class="sole" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="luna" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <a class="btn btn-primario btn-piccolo" href="#contatti" data-contatti>Richiedi preventivo</a>
      </nav>
      <div class="tendina" id="tendina">
        {menu.map(([etichetta, href]) => <a href={href} aria-current={attivo(href) ? 'page' : undefined}>{etichetta}</a>)}
        <a class="btn btn-primario tendina-cta" href="#contatti" data-contatti>Richiedi preventivo</a>
      </div>
    </header>

    <main>
      <slot />
      {!senzaContatto && <Contatto />}
    </main>

    <footer class="sito">
      <div><strong>{azienda.ragioneSociale}</strong><span>{azienda.sede.via}, {azienda.sede.cap} {azienda.sede.citta} ({azienda.sede.provincia})</span><span>Sede legale: {azienda.sedeLegale}</span><span>P.IVA {azienda.piva}</span></div>
      <div><strong>Contatti</strong><a href={`tel:${azienda.cellulare.tel}`} style="font-weight:700">{azienda.cellulare.visibile}</a><a href={azienda.whatsappLink()} rel="noopener">Scrivici su WhatsApp</a><a href={`tel:${azienda.fisso.tel}`}>Fisso {azienda.fisso.visibile}</a><a href={`mailto:${azienda.email}`}>{azienda.email}</a><span>{azienda.orari.breve}</span></div>
      <div><strong>CEAS</strong><span>Dorgali – Cala Gonone</span><span>Omodeo – Sedilo</span></div>
      <div class="legali"><a href="/privacy/">Privacy</a><a href="/cookie/">Cookie</a><button type="button" class="link-btn" data-cookie-preferenze>Preferenze cookie</button></div>
    </footer>

    <div class="barra-mobile" transition:persist="barra">
      <a class="chiama" href={`tel:${azienda.cellulare.tel}`}>Chiama</a>
      <a class="scrivi" href={azienda.whatsappLink()} rel="noopener">WhatsApp</a>
    </div>

    <CookieBanner />
    <script>import '../scripts/sito';</script>
  </body>
</html>
