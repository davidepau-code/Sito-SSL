---
import { settori, dimensioni, attestati, DATA_VERIFICA } from '../data/normativa';
---
<div class="pacchetto card forte" id="pacchetto">
  <div class="pk-sx">
    <h2 class="h3">Scopri cosa ti serve</h2>
    <p class="trova-sotto">Dicci che attività hai e quante persone lavorano con te: ti diciamo noi quali corsi e documenti prevede la legge nel tuo caso, e ti prepariamo la richiesta.</p>

    <label for="pk-settore" class="trova-label">Che attività hai?</label>
    <select id="pk-settore" data-sel>
      <option value="">Scegli il tuo settore</option>
      {settori.map((s) => <option value={s.id}>{s.etichetta}</option>)}
    </select>

    <label for="pk-dim" class="trova-label">Quante persone lavorano con te? <span class="pk-hint">(dipendenti, soci che lavorano, collaboratori, tirocinanti)</span></label>
    <select id="pk-dim" data-sel>
      <option value="">Scegli</option>
      {dimensioni.map((d) => <option value={d}>{d}</option>)}
    </select>

    <div id="pk-domande-box" hidden>
      <h3 class="pk-titolo">Dipende dal tuo lavoro</h3>
      <div id="pk-domande"></div>
    </div>

    <details id="pk-attestati-box" class="pk-attestati" hidden>
      <summary>Ho già alcuni attestati</summary>
      <p class="pk-hint">Spunta quelli che hai: li mettiamo da parte e ti ricordiamo l'aggiornamento. Non conosciamo le date, quindi le controlliamo noi con te.</p>
      <div class="pk-spunte">
        {attestati.map((a) => (
          <label class="pk-spunta"><input type="checkbox" value={a.id} /><span>{a.etichetta}</span></label>
        ))}
      </div>
    </details>
  </div>

  <div class="pk-dx" aria-live="polite">
    <p id="pk-vuoto" class="pk-vuoto">Scegli settore e dimensione: qui compare l'elenco di ciò che ti serve.</p>
    <div id="pk-risultato" hidden>
      <p id="pk-desc" class="trova-sotto"></p>
      <div id="pk-avvisi"></div>

      <p id="pk-riepilogo" class="pk-riepilogo"></p>
      <p id="pk-nessuna" class="pk-nessuna" hidden></p>
      {[['corso', 'Corsi di formazione'], ['documento', 'Documenti da redigere'], ['adempimento', 'Adempimenti']].map(([t, titolo]) => (
        <section class="pk-gruppo" id={`pk-g-${t}`} hidden>
          <h3 class="pk-titolo"><span>{titolo}</span><b class="pk-n"></b></h3>
          <ul id={`pk-lista-${t}`} class="pk-elenco"></ul>
        </section>
      ))}

      <div id="pk-gia-box" hidden>
        <h3 class="pk-titolo">Già in regola (da tenere d'occhio)</h3>
        <ul id="pk-gia" class="pk-elenco pk-elenco-gia"></ul>
      </div>

      <p class="pk-nota">Quadro indicativo basato su D.Lgs. 81/2008 e Accordo Stato-Regioni del 17 aprile 2025, aggiornato al {DATA_VERIFICA}. La composizione esatta (livello di rischio, durate, scadenze) la confermiamo insieme a te, senza impegno. Ti ricordiamo noi le scadenze.</p>
      <div class="gruppo">
        <a id="pk-wa" class="btn btn-primario" href="#" rel="noopener">Invia la richiesta su WhatsApp</a>
        <button id="pk-modulo" type="button" class="btn btn-vetro">Preferisco compilare il modulo</button>
      </div>
    </div>
  </div>
</div>

<script>import '../scripts/pacchetto-ui';</script>
