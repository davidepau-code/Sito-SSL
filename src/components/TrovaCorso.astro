---
import { percorsi } from '../data/catalogo';
---
<div class="trova card forte" id="trova-corso">
  <h2 class="h3">Trova il tuo corso</h2>
  <label for="trova-chi" class="trova-label">Chi sei?</label>
  <select id="trova-chi" data-sel aria-controls="trova-risultati">
    <option value="">Scegli la tua situazione</option>
    {percorsi.map((p) => <option value={p.id}>{p.etichetta}</option>)}
  </select>
  <div id="trova-risultati" aria-live="polite"></div>
  <script is:inline define:vars={{ percorsi }}>
    var sel = document.getElementById('trova-chi'), out = document.getElementById('trova-risultati');
    sel.addEventListener('change', function () {
      var p = percorsi.find(function (x) { return x.id === sel.value; });
      out.innerHTML = '';
      if (!p) return;
      var t = document.createElement('p'); t.className = 'trova-titolo'; t.textContent = 'Per te:'; out.appendChild(t);
      p.risultati.forEach(function (r) {
        var a = document.createElement('a'); a.className = 'trova-risultato'; a.href = r.href; a.textContent = r.nome + ' →'; out.appendChild(a);
      });
    });
  </script>
</div>
