---
interface Props { d: string; size?: number; width?: number }
const { d, size = 16, width = 2.2 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={width} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d}></path></svg>
