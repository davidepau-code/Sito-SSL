---
// Oggetto 3D solo nelle pagine dei singoli corsi (e non sul telefono): three.js si carica solo lì, a pagina pronta e a browser libero, mai su connessioni "risparmio dati".
---
<canvas id="sfondo3d" aria-hidden="true" transition:persist="sfondo3d"></canvas>
<script>
  const conn = (navigator as any).connection;
  const serve = () => innerWidth >= 760 && /^\/formazione\/(?!catalogo|calendario)[^/]+\/?$/.test(location.pathname);
  const carica = () => import('../scripts/sfondo3d');
  const prova = () => {
    if (conn?.saveData || !serve()) return;
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(carica, { timeout: 2500 });
    else setTimeout(carica, 1200);
  };
  prova();
  document.addEventListener('astro:page-load', prova);
</script>
