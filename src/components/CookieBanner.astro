// Avviso cookie. Il sito usa solo cookie tecnici; il consenso serve per la mappa di Google.
---
<div class="cookie-banner card forte" id="cookie-banner" role="region" aria-label="Cookie" hidden transition:persist="cookie">
  <p><strong>Cookie.</strong> Questo sito usa solo cookie tecnici. Per mostrarti la mappa di Google servono i cookie di Google: se accetti, la mappa si vede. <a href="/cookie/">Informativa cookie</a></p>
  <div class="cookie-azioni">
    <button type="button" class="btn btn-primario btn-piccolo" data-consenso="si">Accetta</button>
    <button type="button" class="btn btn-vetro btn-piccolo" data-consenso="no">Rifiuta</button>
  </div>
</div>
