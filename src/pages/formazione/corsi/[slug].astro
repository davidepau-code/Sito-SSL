---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Steps from '../../../components/Steps.astro';
import Faq from '../../../components/Faq.astro';

export async function getStaticPaths() {
  const corsi = await getCollection('corsi', (c) => c.data.paginaPropria);
  return corsi.map((c) => ({ params: { slug: c.id }, props: { corso: c } }));
}
const { corso } = Astro.props;
const { Content } = await render(corso);
const d = corso.data;
const categorie = { sicurezza: 'Sicurezza sul lavoro', attrezzature: 'Attrezzature', 'rischi-specifici': 'Rischi specifici', alimentare: 'Alimentare' };
const sintesi = [
  ['Durata', d.durata],
  ['Aggiornamento', d.aggiornamento],
  ['Modalità', d.modalita.join(' · ')],
  ['Attestato', d.attestato],
];
const verifica = d.ultimaVerificaNormativa.toLocaleDateString('it-IT');
const passi = [
  { titolo: 'Ci dici quanti lavoratori e in che settore operi' },
  { titolo: 'Concordiamo date e sede (anche in azienda)' },
  { titolo: "Ricevi gli attestati e il promemoria per l'aggiornamento" },
];
---
<Base
  title={`${d.titolo} – Servizi Sicurezza Lavoro`}
  description={d.sottotitolo}
  crumbs={[{ nome: 'Home', url: '/' }, { nome: 'Formazione', url: '/formazione/' }, { nome: d.titolo, url: `/formazione/corsi/${corso.id}/` }]}
>
  <section class="sezione testata due-col alto">
    <div class="colonna">
      <div class="briciole"><a href="/formazione/">Formazione</a><span>›</span><span>{categorie[d.categoria]}</span><span>›</span><span aria-current="page">{d.titolo}</span></div>
      <h1>{d.titolo}</h1>
      <p class="lead">{d.sottotitolo}</p>
      <div class="gruppo">
        <a class="btn btn-primario" href="#contatti" data-contatti>Richiedi info</a>
      </div>
    </div>
    <div class="sintesi vetro">
      <header><b>In sintesi</b><span>{d.riferimentoNormativo.split(' – ')[0]}</span></header>
      <dl style="margin:0">
        {sintesi.map(([k, v]) => <div class="riga"><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="sezione stretta griglia larga" data-reveal>
    <div class="card"><h3>A chi è rivolto</h3><p class="testo-corpo">{d.destinatari}</p></div>
    <div class="card"><h3>Cosa dice la norma</h3><div class="testo-corpo"><Content /></div></div>
  </section>
  <p class="sezione stretta" style="color:var(--testo-3);font-size:14px;padding-top:0">Riferimento: {d.riferimentoNormativo}. Dati normativi verificati il {verifica}.</p>

  <Steps passi={passi} />
  {d.faq && <Faq voci={d.faq} />}
</Base>
