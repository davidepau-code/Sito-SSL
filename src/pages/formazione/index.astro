---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Pacchetto from '../../components/Pacchetto.astro';
import { aree } from '../../data/catalogo';
import { sezioni } from '../../data/catalogo-corsi';
const corsiArea = (id: string) => (sezioni.find((s) => s.id === id)?.gruppi ?? []).flatMap((g) => g.corsi);
---
<Base title="Formazione – Servizi Sicurezza Lavoro" description="Corsi obbligatori D.Lgs. 81/08: sicurezza sul lavoro, macchine e attrezzature, rischi specifici, HACCP. In aula, online o in azienda.">
  <section class="sezione testata colonna" style="padding-bottom:24px">
    <h1>Formazione</h1>
    <p class="lead">Quattro aree, per chi ha lavoratori, chi usa macchine, chi lavora con gli alimenti e chi opera in ambienti particolari.</p>
  </section>

  <section class="sezione stretta" style="padding-top:0" data-reveal>
    <div class="fiducia">
      <div><b>E-learning</b>dove e quando vuoi, per i corsi che lo consentono</div>
      <div><b>Videoconferenza</b>in aula virtuale con il docente</div>
      <div><b>In presenza da noi</b>nelle nostre aule a Siniscola</div>
      <div><b>Nella tua azienda</b>veniamo noi da te</div>
    </div>
  </section>

  <section class="sezione stretta" style="padding-top:0">
    <Pacchetto />
  </section>

  <section class="sezione stretta">
    <div class="area-grid">
      {aree.map((a) => (
        <div class="card area" id={a.id} data-reveal>
          <header>
            <span class="icona"><Icon d={a.icona} size={24} width={1.8} /></span>
            <h3>{a.nome}</h3>
          </header>
          <p class="per">{a.per}</p>
          <ul>
            {corsiArea(a.id).map((c) => <li><a href={`/formazione/catalogo/#${c.id}`}>{c.breve}</a></li>)}
          </ul>
          <a class="btn btn-primario btn-piccolo" href={`/formazione/catalogo/#${a.id}`} style="margin-top:auto;align-self:flex-start">Vedi i corsi dell'area</a>
        </div>
      ))}
    </div>
    <div class="gruppo" style="margin-top:32px;align-items:center;gap:16px"><a class="btn btn-primario" href="/formazione/catalogo/">Vai al catalogo completo</a><span style="color:var(--testo-3);font-size:15px">Ore, modalità e aggiornamenti di ogni corso.</span></div>
  </section>
</Base>
