---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Pacchetto from '../../components/Pacchetto.astro';
import { aree } from '../../data/catalogo';
---
<Base title="Formazione – Servizi Sicurezza Lavoro" description="Corsi obbligatori D.Lgs. 81/08: sicurezza sul lavoro, macchine e attrezzature, rischi specifici, HACCP. Aule a Siniscola o in azienda.">
  <section class="sezione testata due-col alto">
    <div class="colonna">
      <h1>Formazione</h1>
      <p class="lead">Quattro aree, per chi ha lavoratori, chi usa macchine, chi lavora con gli alimenti e chi opera in ambienti particolari. Aule a Siniscola o presso la tua azienda.</p>
    </div>
    <Pacchetto />
  </section>

  <section class="sezione stretta">
    <div class="area-grid">
      {aree.map((a) => (
        <div class="card area" id={a.id} data-reveal>
          <header>
            <span class="icona"><Icon d={a.icona} size={24} width={1.8} /></span>
            <h3>{a.nome}</h3>
          </header>
          <p class="per">{a.per}</p>
          <ul>
            {a.corsi.map((c) => <li>{c.slug ? <a href={`/formazione/corsi/${c.slug}/`}>{c.nome}</a> : <span>{c.nome}</span>}</li>)}
          </ul>
        </div>
      ))}
    </div>
    <p style="margin-top:24px;color:var(--testo-3);font-size:15px">Le schede dei singoli corsi sono in arrivo: i corsi senza link sono già in catalogo, chiedici informazioni.</p>
  </section>
</Base>
