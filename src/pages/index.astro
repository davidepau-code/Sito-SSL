---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import Steps from '../components/Steps.astro';
import { azienda } from '../data/azienda';

const GIU = 'M12 5v14M5 12l7 7 7-7';
const FRECCIA = 'M5 12h14M12 5l7 7-7 7';

// "Qual è il tuo caso?": scritto con le parole del cliente, non con i nomi dei corsi.
const casi = [
  { io: 'Ho assunto qualcuno, o sto per farlo', serve: 'Servono la formazione dei lavoratori e il documento di valutazione dei rischi.', href: '/formazione/?caso=assunto#pacchetto', cta: 'Vedi cosa serve', icona: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM19 8v6M22 11h-6' },
  { io: 'Uso muletto, gru, piattaforme o altri mezzi', serve: 'Patentino e aggiornamenti per chi guida o aziona macchine e attrezzature.', href: '/formazione/?caso=macchine#pacchetto', cta: 'Scegli i patentini', icona: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1' },
  { io: 'Ho un bar, un ristorante o un laboratorio', serve: 'Corsi HACCP per il personale e manuale di autocontrollo per l\'attività.', href: '/formazione/?caso=haccp#pacchetto', cta: 'Vedi HACCP', icona: 'M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8zM6 1v3M10 1v3M14 1v3' },
  { io: 'Sono frigorista, termoidraulico o installatore', serve: 'Corso e esame per la certificazione F-Gas, per te o per la tua impresa.', href: '/f-gas/', cta: 'Scopri la certificazione', icona: 'M2 12h20M12 2v20M4.9 4.9l14.2 14.2M19.1 4.9 4.9 19.1' },
];

const passi = [
  { titolo: 'Ci racconti la tua attività', testo: 'Chiamaci o scrivici su WhatsApp: ci bastano il tipo di lavoro e quante persone lavorano con te.' },
  { titolo: 'Ti diciamo cosa serve', testo: 'Corsi, documenti e scadenze che la legge richiede nel tuo caso, spiegati in modo semplice.' },
  { titolo: 'Ce ne occupiamo noi', testo: 'Organizziamo i corsi in aula o in azienda, redigiamo i documenti e ti consegniamo gli attestati.' },
  { titolo: 'Ti seguiamo nel tempo', testo: 'Teniamo noi le scadenze di corsi e documenti e ti avvisiamo prima che scadano.' },
];

const servizi = [
  { titolo: 'Formazione', testo: 'Sicurezza sul lavoro, macchine e attrezzature, rischi specifici, HACCP.', href: '/formazione/', icona: 'M22 10v6M2 10l10-5 10 5-10 5zM6 12v5c3 3 9 3 12 0v-5' },
  { titolo: 'Certificazione F-Gas', testo: 'Corso e esame per frigoristi e imprese.', href: '/f-gas/', icona: 'M2 12h20M12 2v20M4.9 4.9l14.2 14.2M19.1 4.9 4.9 19.1' },
  { titolo: 'Consulenza', testo: 'DVR, DUVRI, POS, manuale HACCP.', href: '/consulenza/', icona: 'M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7ZM14 2v4a2 2 0 0 0 2 2h4M16 13H8M16 17H8' },
  { titolo: 'Pubbliche amministrazioni', testo: 'DVR, DUVRI e formazione per comuni ed enti.', href: '/pubblica-amministrazione/', icona: 'M3 21h18M5 21V10M19 21V10M9 21v-6M15 21v-6M2 10l10-7 10 7' },
];

const faq = [
  'La formazione dei lavoratori è sempre obbligatoria?',
  'Ogni quanto va aggiornato il corso per preposti?',
  'Quando devo aggiornare il DVR?',
  'Sono un termoidraulico: mi serve il patentino F-Gas per installare un climatizzatore?',
].map((domanda) => ({ domanda, risposta: '[Risposta da redigere e verificare su fonte ufficiale]' }));
---
<Base title="Servizi Sicurezza Lavoro – Formazione, consulenza e F-Gas in Sardegna" description="Corsi obbligatori, documenti di sicurezza e certificazione F-Gas per aziende, artigiani e ristoratori della Sardegna. Siniscola, Baronia, Olbia, Nuoro.">
  <section class="sezione testata due-col" style="padding-top:150px;padding-bottom:64px;gap:48px">
    <div class="colonna" style="gap:26px">
      <div class="hero-chip"><span>Sicurezza sul lavoro</span><span>DVR</span><span>HACCP</span><span>F-Gas</span><span>Formazione</span></div>
      <h1 class="grande">Tutto quello che ti serve per essere in regola. Fatto da noi.</h1>
      <p class="lead" style="max-width:560px">Per aziende, artigiani, ristoratori e cantieri della Sardegna: ti diciamo cosa richiede la legge nel tuo caso, ci occupiamo noi di corsi e documenti e teniamo d'occhio le scadenze al posto tuo.</p>
      <div class="gruppo">
        <a class="btn btn-primario" href={azienda.whatsappLink()} rel="noopener">Scrivici su WhatsApp <Icon d={FRECCIA} size={18} /></a>
        <a class="btn btn-vetro" href={`tel:${azienda.cellulare.tel}`}>Chiama {azienda.cellulare.visibile}</a>
        <a class="btn btn-vetro btn-giu" href="#servizi" aria-label="Vai a tutti i nostri servizi" title="Tutti i nostri servizi"><span class="giu-testo">Tutti i servizi</span><Icon d={GIU} size={18} /></a>
      </div>
      <p style="font-size:15px;font-weight:600;color:var(--testo-3)">Siniscola · Baronia · Olbia · Nuoro, in aula o in azienda.</p>
    </div>
    <div style="position:relative;min-height:480px">
      <div class="foto" style="position:absolute;inset:0"><span>Foto: aula di formazione con lavoratori, luce naturale</span></div>
      <div class="vetro" style="position:absolute;left:-20px;top:40px;display:flex;align-items:center;gap:12px;padding:14px 18px 14px 14px;border-radius:var(--r-img)">
        <span class="icona" style="width:40px;height:40px;background:var(--arancio);color:var(--su-arancio)"><Icon d="M20 6 9 17l-5-5" size={20} /></span>
        <span style="display:flex;flex-direction:column;line-height:1.25"><strong style="font-size:15px">Dal 2008</strong><span style="font-size:13px;color:var(--testo-3)">formazione e consulenza a Siniscola</span></span>
      </div>
    </div>
  </section>

  <section class="sezione" data-reveal id="il-tuo-caso">
    <div class="sezione-titolo">
      <h2>Qual è il tuo caso?</h2>
      <p>Scegli la situazione che ti somiglia di più. Ti portiamo dritto a quello che serve.</p>
    </div>
    <div class="casi">
      {casi.map((c) => (
        <a class="card caso glow" href={c.href}>
          <span class="icona"><Icon d={c.icona} size={24} width={1.8} /></span>
          <span class="io">{c.io}</span>
          <span class="serve">{c.serve}</span>
          <span class="cta-link">{c.cta} <Icon d={FRECCIA} /></span>
        </a>
      ))}
    </div>
    <p style="margin-top:24px;color:var(--testo-2)"><a href="/formazione/#pacchetto" style="font-weight:700">Componi il tuo pacchetto di corsi →</a> Scegli settore e dimensione: ti proponiamo i corsi di base e ti prepariamo la richiesta.</p>
    <p style="margin-top:12px;color:var(--testo-2)">Non ti riconosci in nessuno? <a href={azienda.whatsappLink()} rel="noopener" style="font-weight:700">Scrivici cosa fai</a>: ti rispondiamo noi.</p>
  </section>

  <Steps passi={passi} />

  <section class="sezione stretta" data-reveal>
    <div class="card accento" style="padding:clamp(28px,4vw,48px);gap:16px;max-width:900px">
      <h2>La sicurezza è una noia? Per questo c'è chi se ne occupa.</h2>
      <p style="font-size:19px;color:var(--testo-2)">Sappiamo che per chi lavora la sicurezza è un pensiero in più. Noi ti togliamo quel pensiero: sappiamo quali corsi e documenti servono alla tua azienda, teniamo il conto delle scadenze e ti avvisiamo noi quando è ora di rinnovare. Tu pensi al tuo lavoro.</p>
    </div>
  </section>

  <section class="sezione stretta" data-reveal>
    <!-- Numeri forniti dalla direzione (Davide Pau, 2 ottobre 2026): rivederli periodicamente. Voti Google e accreditamento: reinserire solo se verificati. -->
    <div class="fiducia">
      <div><b>Dal 2008</b>a Siniscola, impresa familiare diventata ente di formazione</div>
      <div><b>+10.000</b>corsisti formati</div>
      <div><b>+500</b>aziende seguite in consulenza</div>
      <div><b>Su misura</b>un singolo corso o documento, oppure un pacchetto completo per la tua azienda</div>
    </div>
  </section>

  <section class="sezione" data-reveal id="servizi">
    <div class="sezione-titolo">
      <h2>Tutti i nostri servizi</h2>
      <p>Se sai già cosa cerchi, vai direttamente alla pagina.</p>
    </div>
    <div class="griglia">
      {servizi.map((s) => (
        <a class="card link glow" href={s.href}>
          <span class="icona"><Icon d={s.icona} size={24} width={1.8} /></span>
          <span class="titolo">{s.titolo}</span>
          <span class="corpo">{s.testo}</span>
          <span class="cta-link">Apri <Icon d={FRECCIA} /></span>
        </a>
      ))}
    </div>
  </section>

  <Faq voci={faq} />

  <!-- CEAS: attività a parte, non un servizio alle aziende. Fascia separata e discreta, in fondo. -->
  <section class="sezione stretta" data-reveal>
    <div class="fascia-verde">
      <div class="foto verde" style="min-height:260px"><span>Foto: costa di Cala Gonone o lago Omodeo</span></div>
      <div class="colonna">
        <span class="pillola verde">Un'altra nostra attività</span>
        <h2 style="font-size:clamp(28px,3.4vw,40px)">Non solo sicurezza: i CEAS.</h2>
        <p style="color:var(--testo-2);text-wrap:pretty">Gestiamo due Centri di Educazione all'Ambiente e alla Sostenibilità, a Cala Gonone e a Sedilo, aperti tutto l'anno a scuole, famiglie e visitatori.</p>
        <a class="btn btn-verde" style="align-self:flex-start;font-size:16px;padding:14px 22px" href="/ceas/">Scopri i CEAS <Icon d={FRECCIA} /></a>
      </div>
    </div>
  </section>
</Base>
