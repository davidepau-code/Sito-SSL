---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

const cosaFacciamo = ['Sopralluogo in azienda', 'Valutazione di tutti i rischi', 'Redazione del documento', 'Programma delle misure', 'Aggiornamento quando cambia qualcosa'];
const collegati = ['DUVRI', 'POS', 'Piano di emergenza', 'Valutazione rumore e vibrazioni', 'Valutazione stress lavoro-correlato'];
---
<Base
  title="Documento di Valutazione dei Rischi (DVR) – Servizi Sicurezza Lavoro"
  description="Redigiamo e aggiorniamo il DVR della tua azienda, sopralluogo compreso. DUVRI, POS e piani di emergenza."
  crumbs={[{ nome: 'Home', url: '/' }, { nome: 'Consulenza', url: '/consulenza/' }, { nome: 'Sicurezza sul lavoro', url: '/consulenza/sicurezza-sul-lavoro/' }]}
>
  <section class="sezione testata due-col">
    <div class="colonna">
      <div class="briciole"><a href="/consulenza/">Consulenza</a><span>›</span><span>Sicurezza sul lavoro</span><span>›</span><span aria-current="page">DVR</span></div>
      <h1>Documento di Valutazione dei Rischi (DVR)</h1>
      <p class="lead">Obbligatorio per ogni azienda con almeno un lavoratore. Lo redigiamo con te, sopralluogo compreso, e lo teniamo aggiornato.</p>
      <a class="btn btn-primario" style="align-self:flex-start" href="#contatti" data-contatti>Richiedi un sopralluogo</a>
    </div>
    <div class="foto"><span>Foto: sopralluogo in cantiere o in un capannone</span></div>
  </section>

  <section class="sezione stretta griglia larga" data-reveal>
    <div class="card">
      <h3>Chi è obbligato</h3>
      <p class="testo-corpo">Ogni datore di lavoro con almeno un dipendente o collaboratore equiparato.</p>
      <h3 style="margin-top:16px">Quando va aggiornato</h3>
      <p class="testo-corpo">Modifiche all'organizzazione, nuove attrezzature, infortuni significativi, nuove normative.</p>
    </div>
    <div class="card forte" style="gap:4px">
      <h3 style="margin-bottom:8px">Cosa facciamo</h3>
      <div class="spunte">
        {cosaFacciamo.map((c) => <div><i><Icon d="M20 6 9 17l-5-5" size={14} width={2.6} /></i><span>{c}</span></div>)}
      </div>
    </div>
  </section>

  <section class="sezione stretta" data-reveal>
    <h2 style="font-size:clamp(28px,3.4vw,40px);margin-bottom:20px">Servizi collegati</h2>
    <div class="gruppo" style="gap:10px">{collegati.map((c) => <span class="chip">{c}</span>)}</div>
  </section>
</Base>
