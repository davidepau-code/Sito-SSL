---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { consulenzaPerSlug } from '../../data/consulenze';
const FRECCIA = 'M5 12h14M12 5l7 7-7 7';
const SICUREZZA = 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4';
const iso = consulenzaPerSlug('iso-9001');
const acustico = consulenzaPerSlug('collaudo-acustico');
const haccp = consulenzaPerSlug('haccp');
const tessere = [
  { href: '/consulenza/sicurezza-sul-lavoro/', titolo: 'Sicurezza sul lavoro', testo: 'DVR, DUVRI, POS: i documenti che la legge richiede alla tua azienda, redatti e tenuti aggiornati.', icona: SICUREZZA, cta: 'Vedi i servizi' },
  { href: `/consulenza/${haccp.slug}/`, titolo: 'Sicurezza alimentare', testo: 'Il manuale di autocontrollo HACCP per bar, ristoranti, laboratori e attività che trattano alimenti.', icona: haccp.icona, cta: 'Scopri il manuale HACCP' },
  { href: `/consulenza/${iso.slug}/`, titolo: 'Qualità ISO 9001', testo: iso.riassunto, icona: iso.icona, cta: 'Scopri il servizio' },
  { href: `/consulenza/${acustico.slug}/`, titolo: 'Collaudo acustico', testo: acustico.riassunto, icona: acustico.icona, cta: 'Scopri il servizio' },
];
---
<Base title="Consulenza – Sicurezza, HACCP, ISO 9001, collaudo acustico – Servizi Sicurezza Lavoro" description="Redigiamo i documenti che la legge richiede: sicurezza sul lavoro (DVR, DUVRI, POS), manuale HACCP, sistema qualità ISO 9001 e collaudo acustico degli edifici.">
  <section class="sezione testata colonna">
    <h1>Consulenza sicurezza, HACCP e qualità in Sardegna</h1>
    <p class="lead">Redigiamo i documenti che la legge richiede e li teniamo aggiornati. Scegli di cosa hai bisogno.</p>
  </section>
  <section class="sezione stretta" data-reveal>
    <div class="griglia" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,480px),1fr))">
      {tessere.map((t) => (
        <a class="card link glow" href={t.href}>
          <span class="icona"><Icon d={t.icona} size={24} width={1.8} /></span>
          <span class="titolo">{t.titolo}</span>
          <span class="corpo">{t.testo}</span>
          <span class="cta-link">{t.cta} <Icon d={FRECCIA} /></span>
        </a>
      ))}
    </div>
  </section>
</Base>
