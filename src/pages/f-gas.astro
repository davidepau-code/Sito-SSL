---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import { azienda } from '../data/azienda';

const FRECCIA = 'M5 12h14M12 5l7 7-7 7';
const wa = (m: string) => azienda.whatsappFgas(m); // sempre al WhatsApp di Michela, referente F-Gas

// "Di cosa hai bisogno?": cinque percorsi, ognuno porta a una sezione o a una richiesta.
const percorsi = [
  { io: 'Devo certificare la mia impresa', serve: 'Ti accompagniamo nell\'iter di certificazione F-Gas dell\'azienda.', href: '#impresa', cta: 'Certifica la tua impresa', icona: 'M3 21h18M5 21V7l7-4 7 4v14M9 9h1M14 9h1M9 13h1M14 13h1M10 21v-4h4v4' },
  { io: 'Devo prepararmi all\'esame', serve: 'Corso teorico in videoconferenza, in diretta con il docente, per i tecnici che devono sostenere l\'esame.', href: '#formazione', cta: 'Vedi il corso', icona: 'M22 10v6M2 10l10-5 10 5-10 5zM6 12v5c3 3 9 3 12 0v-5' },
  { io: 'Devo sostenere l\'esame', serve: 'Sessioni d\'esame organizzate da noi come Organismo di Valutazione di IMQ.', href: '#esami', cta: 'Vedi come funziona', icona: 'M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11' },
  { io: 'Devo gestire un adempimento F-Gas', serve: 'Registro, Banca Dati, abilitazioni e comunicazione degli interventi.', href: '#adempimenti', cta: 'Vedi l\'assistenza', icona: 'M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7ZM14 2v4a2 2 0 0 0 2 2h4M16 13H8M16 17H8' },
];

const impresa = [
  'Analisi preliminare della situazione aziendale',
  'Verifica dei requisiti necessari',
  'Verifica del personale certificato',
  'Verifica delle attrezzature disponibili',
  'Supporto nella predisposizione della documentazione',
  'Predisposizione o revisione delle procedure',
  'Verifica della conformità organizzativa',
  'Preparazione dell\'impresa all\'iter di certificazione',
  'Supporto nella gestione di eventuali carenze',
  'Assistenza durante tutto il percorso',
];
const formazione = [
  'Preparazione teorica alla prova d\'esame',
  'Normativa F-Gas',
  'Principi tecnici su impianti e refrigeranti',
  'Obblighi dell\'operatore',
  'Aggiornamenti normativi e tecnici',
  'Informazioni su come si accede all\'esame',
];
const adempimenti = [
  'Consulenza normativa F-Gas e verifica degli obblighi applicabili',
  'Iscrizioni e abilitazioni',
  'Supporto al Registro F-Gas e alla Banca Dati F-Gas',
  'Gestione e verifica delle abilitazioni necessarie',
  'Assistenza nella comunicazione degli interventi',
  'Verifica della corretta gestione documentale',
  'Assistenza per problemi operativi con la Banca Dati',
];
const esame = [
  { t: 'Le quattro categorie', d: 'Categoria I: tutte le attività. Categoria II: controllo delle perdite (senza intervenire sui circuiti), recupero, installazione, manutenzione e smantellamento su apparecchiature con meno di 3 kg di gas (6 kg se sigillate ermeticamente). Categoria III: solo recupero, sulle stesse apparecchiature. Categoria IV: solo controllo delle perdite, senza intervenire sui circuiti.' },
  { t: 'Requisiti di accesso', d: 'Per accedere all’esame bisogna essere già iscritti al Registro Telematico Nazionale F-Gas, e il certificato va ottenuto entro 8 mesi dall’iscrizione. La domanda di ammissione va inviata almeno 5 giorni lavorativi prima della data scelta. Le prove si svolgono in italiano.' },
  { t: 'Prova teorica', d: 'Domande a risposta multipla, con tre alternative e una sola corretta: 30 domande per le categorie I e II, 12 per la III, 15 per la IV. Durata massima 90 minuti per le categorie I e II, 30 minuti per la III e la IV. Serve almeno il 60%.' },
  { t: 'Prova pratica', d: 'Si svolgono compiti con il materiale e gli strumenti messi a disposizione, indossando i DPI. La prova riguarda tutti i temi obbligatori e almeno uno dei gruppi sui componenti, che non si conosce prima. Durata massima 90 minuti per le categorie I e II, 45 minuti per la III e la IV. Si accede alla pratica solo superando la teoria.' },
  { t: 'Esito dell’esame', d: 'Per superare l’esame serve almeno il 60% in ciascuna prova e almeno il 70% complessivo, dove la pratica pesa più della teoria (30% teoria, 70% pratica). Chi supera la teoria ma non la pratica può ripetere solo la pratica, entro i termini previsti dalla norma.' },
  { t: 'Documenti richiesti', d: 'Domanda di ammissione compilata e firmata, attestato di iscrizione al Registro Telematico Nazionale, documento d’identità in corso di validità, fotografia formato tessera e prova dell’avvenuto pagamento.' },
];
const faq = [
  {
    domanda: 'Quanto dura la certificazione?',
    risposta: 'La certificazione della persona dura 10 anni dalla data di emissione. Ogni anno c’è una verifica di sorveglianza fatta sui documenti: una dichiarazione sui reclami e sull’attività svolta, l’estratto della Banca Dati F-Gas con gli interventi, il documento d’identità e la prova del pagamento. Per rinnovarla si rifà l’esame, e la domanda va presentata entro 60 giorni prima della scadenza.',
  },
  {
    domanda: "Che differenza c’è tra certificazione della persona e dell’impresa?",
    risposta: 'La certificazione della persona riguarda il singolo tecnico: si ottiene superando l’esame teorico e pratico e la rilascia un organismo di certificazione, nel nostro caso IMQ. La certificazione dell’impresa riguarda l’azienda che svolge le attività e richiede, tra l’altro, personale certificato, attrezzature adeguate e procedure. Per ottenere quest’ultima possiamo accompagnarti noi.',
  },
  {
    domanda: 'Posso installare un climatizzatore senza patentino?',
    risposta: 'In generale no: installare, mantenere o riparare apparecchiature che contengono gas fluorurati richiede la certificazione della persona, nella categoria giusta, e l’iscrizione al Registro. Se non sei sicuro che il tuo caso rientri, scrivi a Michela e lo vediamo insieme.',
  },
  {
    domanda: 'Cosa succede se la mia certificazione scade?',
    risposta: 'Se non invii i documenti della verifica annuale, la certificazione viene sospesa. Se i documenti non arrivano nemmeno entro 180 giorni dopo la scadenza, viene revocata e, prima di fare un nuovo intervento, bisogna rifare tutto l’iter con esame teorico e pratico. Alla scadenza dei 10 anni la certificazione si rinnova rifacendo l’esame.',
  },
];
// Chi fa cosa: tre ruoli distinti.
const passi = [
  { titolo: 'Ti prepari con noi', testo: 'SSL tiene la formazione teorica di preparazione all\'esame.' },
  { titolo: 'Sostieni l\'esame', testo: 'Le sessioni, teoria e pratica, si svolgono nella nostra sede a Siniscola, organizzate da SSL in qualità di Organismo di Valutazione di IMQ.' },
  { titolo: 'IMQ certifica', testo: 'IMQ, Organismo di Certificazione, rilascia la certificazione al termine dell\'iter previsto.' },
];
// Sessioni d'esame: per ora l'ultimo sabato di ogni mese, TUTTE da confermare.
// Calcolate alla pubblicazione (le prossime 6); uno script nasconde quelle già passate.
const ultimoSabato = (anno: number, mese: number) => {
  const d = new Date(Date.UTC(anno, mese + 1, 0)); // ultimo giorno del mese
  d.setUTCDate(d.getUTCDate() - ((d.getUTCDay() + 1) % 7)); // indietro fino al sabato
  return d;
};
const oggi = new Date();
const sessioni: { iso: string; testo: string; nota: string }[] = [];
for (let i = 0; sessioni.length < 6 && i < 14; i++) {
  const d = ultimoSabato(oggi.getUTCFullYear(), oggi.getUTCMonth() + i);
  if (d.getTime() < Date.UTC(oggi.getUTCFullYear(), oggi.getUTCMonth(), oggi.getUTCDate())) continue;
  const t = d.toLocaleDateString('it-IT', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
  // Dicembre: niente giorno (cade a ridosso delle festività), la data è da definire
  const dic = d.getUTCMonth() === 11;
  const testo = dic ? 'Dicembre ' + d.getUTCFullYear() : t.charAt(0).toUpperCase() + t.slice(1);
  sessioni.push({ iso: d.toISOString().slice(0, 10), testo, nota: dic ? '(Data da definire)' : '(Da confermare)' });
}
const CHECK = 'M20 6 9 17l-5-5';
---
<Base title="Corso e Certificazione F-Gas in Sardegna (Patentino Frigoristi)" description="Corso, esame e certificazione F-Gas per frigoristi, termoidraulici e imprese in Sardegna. Prepara l'esame o certifica la tua impresa con noi.">
  <section class="sezione testata due-col">
    <div class="colonna">
      <span class="pillola" style="align-self:flex-start">F-Gas</span>
      <h1>Corso e certificazione F-Gas in Sardegna</h1>
      <p class="lead">Dalla preparazione all'esame alla certificazione dell'impresa. Per frigoristi, termoidraulici e installatori di climatizzatori e pompe di calore. Ti prepariamo, organizziamo l'esame e accompagniamo la tua impresa fino alla certificazione, poi ci occupiamo degli adempimenti.</p>
      <div class="gruppo">
        <a class="btn btn-primario" href="#impresa">Certifica la tua impresa <Icon d={FRECCIA} size={18} /></a>
        <a class="btn btn-vetro btn-giu" href="#bisogno">Di cosa hai bisogno? <Icon d="M12 5v14M5 12l7 7 7-7" size={18} /></a>
      </div>
    </div>
    <div class="foto" style="min-height:420px"><span>Foto: tecnico al lavoro su un impianto di refrigerazione</span></div>
  </section>

  <section class="sezione" data-reveal id="bisogno" style="scroll-margin-top:80px">
    <div class="sezione-titolo">
      <h2>Di cosa hai bisogno?</h2>
      <p>Scegli la tua situazione: ti portiamo subito alla risposta.</p>
    </div>
    <div class="casi">
      {percorsi.map((c) => (
        <a class="card caso glow" href={c.href}>
          <span class="icona"><Icon d={c.icona} size={24} width={1.8} /></span>
          <span class="io">{c.io}</span>
          <span class="serve">{c.serve}</span>
          <span class="cta-link">{c.cta} <Icon d={FRECCIA} /></span>
        </a>
      ))}
    </div>
    <p style="margin-top:24px;color:var(--testo-2)">Hai un dubbio? <a href={wa('Buongiorno, ho bisogno di assistenza sul F-Gas.')} rel="noopener" style="font-weight:700">Scrivi a {azienda.fgas.referente}</a>, la nostra referente F-Gas: ti risponde lei.</p>
  </section>

  <section class="sezione" data-reveal id="impresa" style="scroll-margin-top:80px">
    <div class="card scura" style="padding:clamp(28px,4vw,56px);gap:28px">
      <div style="display:flex;flex-direction:column;gap:12px;max-width:760px">
        <span class="pillola" style="align-self:flex-start">Per le imprese</span>
        <h2>Certifica la tua impresa</h2>
        <p style="font-size:18px;color:#d9d6d2">Assistiamo le imprese che devono ottenere o mantenere la certificazione F-Gas aziendale: partiamo da una verifica della tua situazione e ti accompagniamo passo per passo, senza lasciarti da solo con le carte.</p>
      </div>
      <ul class="fg-elenco">
        {impresa.map((v) => <li><Icon d={CHECK} size={18} width={2.4} /><span>{v}</span></li>)}
      </ul>
      <div class="gruppo">
        <a class="btn btn-primario" href={wa('Buongiorno, vorrei una verifica preliminare per la certificazione F-Gas della mia impresa.')} rel="noopener">Richiedi una verifica preliminare <Icon d={FRECCIA} size={18} /></a>
        <a class="btn" href={wa('Buongiorno, vorrei parlare con un consulente F-Gas.')} rel="noopener">Parla con {azienda.fgas.referente}, consulente F-Gas</a>
        <a class="btn solo-pc" href={`tel:${azienda.fgas.tel}`}>Chiama {azienda.fgas.visibile}</a>
      </div>
    </div>
  </section>

  <section class="sezione stretta" data-reveal id="formazione" style="scroll-margin-top:80px">
    <div class="sezione-titolo">
      <h2>Formazione pre-esame</h2>
      <p>Corso teorico in videoconferenza sincrona (in diretta con il docente) per i tecnici che devono affrontare l'esame di certificazione F-Gas della persona.</p>
    </div>
    <div class="due-col alto">
      <div class="card">
        <span class="titolo">Cosa si studia</span>
        <ul class="fg-elenco chiaro">
          {formazione.map((v) => <li><Icon d={CHECK} size={18} width={2.4} /><span>{v}</span></li>)}
        </ul>
        <p class="corpo" style="flex:0;font-size:14.5px">Il corso è teorico e si svolge in videoconferenza sincrona, cioè in diretta con il docente.</p>
      </div>
      <div class="card scura">
        <h3>Prossime date del corso</h3>
        {sessioni.length > 0
          ? <><div class="gruppo" style="gap:8px">{sessioni.map((s, i) => <span class="chip" data-sessione={s.iso} hidden={i > 0} style="background:rgb(255 255 255 / .1);box-shadow:none;border:0">{s.testo} <em style="font-style:normal;color:var(--arancio-chiaro)">{s.nota}</em></span>)}</div>
            <p style="color:#d9d6d2;font-size:15px">Per avere la conferma della data, contattaci.</p></>
          : <p style="color:#d9d6d2">Date in definizione: contattaci per sapere quando parte il prossimo corso.</p>}
        <div class="gruppo">
          <a class="btn btn-primario" style="font-size:16px;padding:13px 22px" href={wa('Buongiorno, vorrei iscrivermi al corso di preparazione all\'esame F-Gas.')} rel="noopener">Iscriviti al corso</a>
          <a class="btn" style="font-size:16px;padding:13px 22px" href={wa('Buongiorno, vorrei informazioni sul F-Gas.')} rel="noopener">Richiedi informazioni</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sezione stretta" data-reveal id="esami" style="scroll-margin-top:80px">
    <div class="sezione-titolo">
      <h2>Esami e certificazione della persona</h2>
      <p>Sono due momenti distinti: l'esame lo organizziamo noi come Organismo di Valutazione di IMQ, nella nostra sede a Siniscola (prova teorica e prova pratica); la certificazione la rilascia IMQ.</p>
    </div>
    <div class="griglia larga">
      {esame.map((e) => (
        <div class="card">
          <span class="titolo">{e.t}</span>
          <span class="corpo">{e.d}</span>
        </div>
      ))}
    </div>
    <p style="margin-top:14px;color:var(--testo-3);font-size:14px">Fonte: prescrizioni IMQ per la certificazione di persone (Reg. UE 2015/2067), revisione 5 del 26/02/2026. Le regole possono cambiare: ti confermiamo sempre i dettagli prima dell'iscrizione.</p>
    <div class="card scura" style="margin-top:20px">
      <h3>Prossime sessioni d'esame</h3>
      <p style="color:#d9d6d2;font-size:15px">Sede d'esame: {azienda.sede.via}, {azienda.sede.cap} {azienda.sede.citta} ({azienda.sede.provincia}).</p>
      {sessioni.length > 0
        ? <><div class="gruppo" style="gap:8px">{sessioni.map((s, i) => <span class="chip" data-sessione={s.iso} hidden={i > 0} style="background:rgb(255 255 255 / .1);box-shadow:none;border:0">{s.testo} <em style="font-style:normal;color:var(--arancio-chiaro)">{s.nota}</em></span>)}</div>
          <p style="color:#d9d6d2;font-size:15px">Per avere la conferma della data, contattaci.</p></>
        : <p style="color:#d9d6d2">Date in definizione: contattaci per sapere quando parte la prossima sessione.</p>}
      <div class="gruppo">
        <a class="btn btn-primario" style="font-size:16px;padding:13px 22px" href={wa('Buongiorno, vorrei iscrivermi a una sessione d\'esame F-Gas.')} rel="noopener">Iscriviti all'esame</a>
        <a class="btn" style="font-size:16px;padding:13px 22px" href={wa('Buongiorno, vorrei informazioni sul F-Gas.')} rel="noopener">Richiedi informazioni</a>
      </div>
    </div>
  </section>

  <Steps passi={passi} />

  <section class="sezione stretta" data-reveal id="adempimenti" style="scroll-margin-top:80px">
    <div class="sezione-titolo">
      <h2>Consulenza e adempimenti F-Gas</h2>
      <p>Per imprese e tecnici che hanno bisogno di una mano con la gestione quotidiana degli obblighi.</p>
    </div>
    <div class="due-col alto">
      <div class="card">
        <ul class="fg-elenco chiaro">
          {adempimenti.map((v) => <li><Icon d={CHECK} size={18} width={2.4} /><span>{v}</span></li>)}
        </ul>
      </div>
      <div class="colonna" style="gap:14px">
        <a class="card caso glow" href={wa('Buongiorno, ho un problema con la Banca Dati F-Gas.')} rel="noopener">
          <span class="io">Hai un problema con la Banca Dati?</span>
          <span class="serve">Raccontaci cosa succede: ti aiutiamo a risolverlo.</span>
          <span class="cta-link">Richiedi assistenza <Icon d={FRECCIA} /></span>
        </a>
        <a class="card caso glow" href={wa('Buongiorno, devo comunicare un intervento F-Gas.')} rel="noopener">
          <span class="io">Devi comunicare un intervento?</span>
          <span class="serve">Ti seguiamo nella comunicazione prevista dalla normativa.</span>
          <span class="cta-link">Chiedi aiuto <Icon d={FRECCIA} /></span>
        </a>
      </div>
    </div>
  </section>

  <Faq titolo="Domande frequenti sul F-Gas" voci={faq} />
</Base>
