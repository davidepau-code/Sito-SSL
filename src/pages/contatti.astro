---
import Base from '../layouts/Base.astro';
import { azienda } from '../data/azienda';
const contatti = [
  ['Cellulare e WhatsApp', azienda.cellulare.visibile, `tel:${azienda.cellulare.tel}`],
  ['Fisso', azienda.fisso.visibile, `tel:${azienda.fisso.tel}`],
  ['Email', azienda.email, `mailto:${azienda.email}`],
  ['Orari', azienda.orari.breve, ''],
  ['Sede', `${azienda.sede.via}, ${azienda.sede.cap} ${azienda.sede.citta} (${azienda.sede.provincia})`, ''],
];
---
<Base title="Contatti e preventivo – Servizi Sicurezza Lavoro" description="Contatta Servizi Sicurezza Lavoro a Siniscola: telefono, email e modulo per richiedere un preventivo.">
  <section class="sezione testata colonna" style="padding-bottom:16px;gap:32px">
    <div class="colonna" style="gap:20px">
      <h1 class="grande" style="font-size:clamp(42px,6vw,72px)">Contattaci</h1>
      <p class="lead">Rispondiamo entro [24 ore lavorative].</p>
    </div>
    <div class="griglia" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:12px">
      {contatti.map(([k, v, href], i) => (
        <div class="card forte" style={`padding:20px 22px;gap:4px;border-radius:var(--r-img)${i === 0 ? ';grid-column:1/-1;background:rgb(245 134 42 / .16)' : ''}`}>
          <span style="font-size:13px;font-weight:700;color:var(--testo-3)">{k}</span>
          {href ? <a href={href} style={`font-size:${i === 0 ? 26 : 16}px;font-weight:${i < 2 ? 800 : 700};color:var(--testo)`}>{v}</a> : <span style="font-size:16px;font-weight:700">{v}</span>}
          {i === 0 && <a class="cta-link" href={azienda.whatsappLink()} rel="noopener">Scrivici su WhatsApp →</a>}
        </div>
      ))}
    </div>
  </section>
</Base>
