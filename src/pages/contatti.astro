---
import Base from '../layouts/Base.astro';
import { azienda } from '../data/azienda';
const indirizzo = `${azienda.sede.via}, ${azienda.sede.cap} ${azienda.sede.citta} (${azienda.sede.provincia})`;
const mappa = encodeURIComponent(`${azienda.sede.via}, ${azienda.sede.cap} ${azienda.sede.citta} ${azienda.sede.provincia}`);
---
<Base title="Contatti e preventivo – Servizi Sicurezza Lavoro" description="Contatta Servizi Sicurezza Lavoro a Siniscola: telefono, email e modulo per richiedere un preventivo.">
  <section class="sezione testata colonna" style="padding-bottom:16px;gap:32px">
    <div class="colonna" style="gap:20px">
      <h1 class="grande" style="font-size:clamp(42px,6vw,72px)">Contattaci</h1>
      <p class="lead">Ti rispondiamo il prima possibile, di solito in giornata o entro il giorno lavorativo successivo.</p>
    </div>
    <div class="griglia" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px">
      <div class="card forte" style="padding:18px 22px;gap:4px;border-radius:var(--r-img);background:rgb(245 134 42 / .16)">
        <span style="font-size:13px;font-weight:700;color:var(--testo-3)">Cellulare e WhatsApp</span>
        <a href={`tel:${azienda.cellulare.tel}`} style="font-size:22px;font-weight:800;color:var(--testo)">{azienda.cellulare.visibile}</a>
        <a class="cta-link" href={azienda.whatsappLink()} rel="noopener">Scrivici su WhatsApp →</a>
      </div>
      <div class="card forte" style="padding:18px 22px;gap:4px;border-radius:var(--r-img)">
        <span style="font-size:13px;font-weight:700;color:var(--testo-3)">Fisso</span>
        <a href={`tel:${azienda.fisso.tel}`} style="font-size:20px;font-weight:800;color:var(--testo)">{azienda.fisso.visibile}</a>
      </div>
      <div class="card forte" style="padding:18px 22px;gap:4px;border-radius:var(--r-img)">
        <span style="font-size:13px;font-weight:700;color:var(--testo-3)">Email</span>
        <a href={`mailto:${azienda.email}`} style="font-size:16px;font-weight:700;color:var(--testo);overflow-wrap:anywhere">{azienda.email}</a>
      </div>
    </div>
    <div class="griglia" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:12px;align-items:stretch">
      <div class="card forte" style="padding:22px;gap:10px;border-radius:var(--r-img)">
        <span style="font-size:13px;font-weight:700;color:var(--testo-3)">Orari</span>
        <span style="font-size:18px;font-weight:700">{azienda.orari.testo}</span>
        <span style="color:var(--testo-3)">Sabato e domenica chiuso.</span>
      </div>
      <div class="card forte" style="padding:0;overflow:hidden;border-radius:var(--r-img);min-height:300px;position:relative">
        <iframe title="Mappa della sede di Servizi Sicurezza Lavoro a Siniscola" src={`https://maps.google.com/maps?q=${mappa}&ftid=0x12dec2ee933aefd1:0xe94bd3577da643a7&output=embed&hl=it`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" style="border:0;width:100%;height:100%;min-height:300px;display:block"></iframe>
      </div>
    </div>
    <p style="color:var(--testo-2)"><strong>Sede:</strong> {indirizzo}. <a href={`https://www.google.com/maps/dir/?api=1&destination=${mappa}`} rel="noopener" target="_blank" style="font-weight:700">Apri in Google Maps →</a></p>
  </section>
</Base>
